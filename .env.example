MONGO_URI=mongodb://127.0.0.1:27017/coachingos
# Required only when local DNS blocks MongoDB SRV lookups.
# Example:
MONGO_ATLAS_HOSTS=
MONGO_ATLAS_REPLICA_SET=

PORT=5000
HOST=0.0.0.0
PUBLIC_HOST=<PC-LAN-IP>
PUBLIC_DOMAIN=
FRONTEND_PORT=5173
CLIENT_ORIGIN=https://<PC-LAN-IP>:5000,https://<PC-LAN-IP>:5173,http://<PC-LAN-IP>:5000,http://<PC-LAN-IP>:5173

HTTPS_ENABLED=true
HTTPS_PFX_PATH=certificates/coachingos.pfx
HTTPS_PFX_PASSWORD=change-me
HTTPS_FALLBACK_TO_HTTP=true

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COACHINGOS_LICENSE_DIR=C:\ProgramData\CoachingOS
FRONTEND_DIR=frontend

ALLOW_LEGACY_ROLLNO_SCAN=false
PUBLIC_SCAN_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_SCAN_RATE_LIMIT_MAX=90
